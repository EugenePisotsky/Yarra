(
    schema_version: 3,
    skeletons: [
        (
            id: "skeletons/yarra_humanoid_v1",
            name: "Yarra Humanoid V1",
        ),
        // MPFB's 53-bone skeleton for game engines, fitted to each MPFB body.
        (
            id: "skeletons/mpfb_game_engine",
            name: "MPFB Game Engine",
        ),
    ],
    models: [
        (
            id: "models/female_main",
            name: "Female Main",
            skeleton: "skeletons/yarra_humanoid_v1",
            visual: (
                asset: "local/characters/female_main/female_main_locomotion.glb",
                scene: 0,
                translation_m: (0.0, 0.0, 0.0),
                yaw_degrees: 0.0,
                uniform_scale: 1.0,
            ),
            // Measured on the Walk clip's planted feet.
            feet: (
                joints: [("foot.l", "toes_01.l"), ("foot.r", "toes_01.r")],
                ankle_height_m: 0.068,
                toe_height_m: 0.012,
                heel_behind_ankle_m: 0.065,
                toe_ahead_m: 0.06,
                heel_radius_m: 0.04,
                ball_radius_m: 0.045,
                // A shin and the snow it drags: the two legs' channels join into one between
                // them, its floor over the soles' lanes.
                wade_radius_m: 0.14,
                wade_floor_m: 0.12,
            ),
        ),
        // MPFB's body fitted to female_main, with female_main's clips retargeted
        // (content/characters/scripts/export_glb.py).
        (
            id: "models/mpfb_fitted",
            name: "MPFB Fitted",
            skeleton: "skeletons/mpfb_game_engine",
            visual: (
                asset: "local/characters/fitted_body/fitted_body.glb",
                scene: 0,
                translation_m: (0.0, 0.0, 0.0),
                yaw_degrees: 0.0,
                uniform_scale: 1.0,
            ),
            // The export's measures: the joints' lowest heights over the clips, the shoe's reach
            // at rest.
            feet: (
                joints: [("foot_l", "ball_l"), ("foot_r", "ball_r")],
                ankle_height_m: 0.067,
                toe_height_m: 0.01,
                heel_behind_ankle_m: 0.064,
                toe_ahead_m: 0.082,
                heel_radius_m: 0.04,
                ball_radius_m: 0.045,
                wade_radius_m: 0.14,
                wade_floor_m: 0.12,
            ),
        ),
    ],
    animation_banks: [
        (
            id: "banks/female_main/locomotion",
            name: "Female Main Locomotion",
            skeleton: "skeletons/yarra_humanoid_v1",
            asset: "local/characters/female_main/female_main_locomotion.glb",
        ),
        (
            id: "banks/mpfb_fitted/locomotion",
            name: "MPFB Fitted Locomotion",
            skeleton: "skeletons/mpfb_game_engine",
            asset: "local/characters/fitted_body/fitted_body.glb",
        ),
    ],
    clips: [
        (
            id: "clips/female_main/idle/base",
            name: "Idle",
            bank: "banks/female_main/locomotion",
            animation: "Idle",
            playback: Loop,
        ),
        (
            id: "clips/female_main/walk/loop",
            name: "Walk",
            bank: "banks/female_main/locomotion",
            animation: "Walk",
            playback: Loop,
        ),
        (
            id: "clips/female_main/jog/loop",
            name: "Jog",
            bank: "banks/female_main/locomotion",
            animation: "Jog",
            playback: Loop,
        ),
        (
            id: "clips/mpfb_fitted/idle/base",
            name: "Idle",
            bank: "banks/mpfb_fitted/locomotion",
            animation: "Idle",
            playback: Loop,
        ),
        (
            id: "clips/mpfb_fitted/walk/loop",
            name: "Walk",
            bank: "banks/mpfb_fitted/locomotion",
            animation: "Walk",
            playback: Loop,
        ),
        (
            id: "clips/mpfb_fitted/jog/loop",
            name: "Jog",
            bank: "banks/mpfb_fitted/locomotion",
            animation: "Jog",
            playback: Loop,
        ),
    ],
    movement_sets: [
        (
            id: "movement/female_main/standing",
            name: "Female Main Standing",
            skeleton: "skeletons/yarra_humanoid_v1",
            idle_clip: "clips/female_main/idle/base",
            walk: (
                clip: "clips/female_main/walk/loop",
                speed_mps: 1.9686075,
            ),
            jog: (
                clip: "clips/female_main/jog/loop",
                speed_mps: 2.941954,
            ),
            tuning: (
                input_dead_zone: 0.18,
                input_response_exponent: 1.0,
                walk_to_jog_threshold: 0.72,
                jog_to_walk_threshold: 0.60,
                walk_acceleration_seconds: 0.22,
                jog_acceleration_seconds: 0.22,
                release_seconds: 0.16,
                gait_blend_seconds: 0.24,
                arrival_radius_m: 0.01,
                start_blend_seconds: 0.22,
                stop_blend_seconds: 0.26,
                walk_turn_rate_radians: 7.0685835,
                jog_turn_rate_radians: 5.497787,
            ),
        ),
        (
            id: "movement/mpfb_fitted/standing",
            name: "MPFB Fitted Standing",
            skeleton: "skeletons/mpfb_game_engine",
            idle_clip: "clips/mpfb_fitted/idle/base",
            walk: (
                clip: "clips/mpfb_fitted/walk/loop",
                speed_mps: 1.9686075,
            ),
            jog: (
                clip: "clips/mpfb_fitted/jog/loop",
                speed_mps: 2.941954,
            ),
            tuning: (
                input_dead_zone: 0.18,
                input_response_exponent: 1.0,
                walk_to_jog_threshold: 0.72,
                jog_to_walk_threshold: 0.60,
                walk_acceleration_seconds: 0.22,
                jog_acceleration_seconds: 0.22,
                release_seconds: 0.16,
                gait_blend_seconds: 0.24,
                arrival_radius_m: 0.01,
                start_blend_seconds: 0.22,
                stop_blend_seconds: 0.26,
                walk_turn_rate_radians: 7.0685835,
                jog_turn_rate_radians: 5.497787,
            ),
        ),
    ],
    profiles: [
        (
            id: "presentations/female/default",
            name: "Female Default",
            model: "models/female_main",
            default_movement_context: "standing",
            movement_sets: [
                (
                    context: "standing",
                    movement_set: "movement/female_main/standing",
                ),
            ],
        ),
        (
            id: "presentations/female/mpfb_fitted",
            name: "Female MPFB Fitted",
            model: "models/mpfb_fitted",
            default_movement_context: "standing",
            movement_sets: [
                (
                    context: "standing",
                    movement_set: "movement/mpfb_fitted/standing",
                ),
            ],
        ),
    ],
)
