// Grass of the Baltic coast island and what grows on each ground surface of the `baltic`
// terrain pack (assets/packs/terrain/baltic.toml).
//
// New worlds take it when created; `yarra-world-cook import-grass` puts an edited pack into an
// existing world and cooks it. The game also reloads the types' looks from this file while it
// runs, so shapes, colours, density and wind response can be tuned live; which types grow where
// (`surfaces`) and the ground's grass colour (the field's tint where blades thin out and on
// distant terrain) need a cook.
//
// Per type (ranges are (minimum, maximum); every blade picks its value, its clump shared by its
// neighbours):
// - `density`: roots per square metre where the type grows at full amount.
// - `twin`: each root grows two blades in a V, sharing one blade's vertices (Ghost of Tsushima's
//   doubled blades): twice the blades for the same cost, with fewer bends each.
// - `height`, `width`: blade height and root width in metres; blades taper to a point.
// - `tilt`: how far the tip leans from upright (0 upright, 1 lying flat).
// - `bend`: how much the blade's middle arches above the line from root to tip.
// - `clumps`: Voronoi clumps `size` metres apart. `pull` gathers roots toward clump centres
//   (0 even turf, 1 tight tussocks); `height` is how much clumps differ in height; `facing` the
//   share of blades facing their clump's common direction; `splay` how much blades fan outward;
//   `patches` how partial coverage thins the type (0 single blades evenly, 1 whole clumps, so
//   sparse grass grows as separate tussocks).
// - `colors`: linear RGB at the root and tip; a `dry` share of clumps has the `dry_tip`;
//   `variation` is clump-to-clump brightness.
// - `gloss`, `roughness`: the sun's and moon's sheen on the blades; gloss 0..2, above 1 waxier
//   than a plain dielectric. `translucency`: the share of the sun a blade passes when seen
//   against the light. `stiffness`: 0 sways freely, 1 barely moves.
//
// `details`: small objects strewn over the ground, each a random piece of its `assets` (glTF files
// under assets/ whose meshes are the pieces: props made by tools/import_detail_props.py from a
// Megascans pack in ~/Dev/Assets/props/sources, plants from the yarra_* vegetation bundles, which
// sway and are shaded like tree foliage). `density` objects per square metre at full amount; `scale` range
// of the pieces as authored; `clumps` as grass's (size, pull, patches); `sink` share of a piece's
// height sunk into the ground; `align` how far pieces follow the slope (0 upright, 1 the ground's
// normal) and `tilt` random lean, radians; `distance` metres at which they have faded out;
// `shadows` whether they cast them.
//
// `surfaces`: terrain surface key → (grass or detail key, share of its density). Unlisted surfaces
// stay bare. A surface may carry several types; shares need not sum to 1.
(
    terrain: "baltic",
    types: [
        // Mixed fescue and bent grass of the meadows. Long blades that rise and lie over, combed
        // one way by each clump, cover the ground as Ghost of Yotei's fields do.
        (
            key: "meadow",
            density: 56.0,
            height: (0.4, 0.85),
            width: (0.014, 0.028),
            tilt: (0.35, 0.95),
            bend: (0.25, 0.8),
            clumps: (size: 0.9, pull: 0.2, height: 0.4, facing: 0.75, splay: 0.15, patches: 0.4),
            colors: (
                root: (0.02, 0.03, 0.01),
                tip: (0.075, 0.115, 0.03),
                dry_tip: (0.22, 0.2, 0.08),
                dry: 0.1,
                variation: 0.18,
            ),
            gloss: 1.6,
            roughness: 0.42,
            translucency: 0.3,
            stiffness: 0.35,
            twin: true,
        ),
        // Timothy and cocksfoot stems standing above the meadow.
        (
            key: "meadow-tall",
            density: 5.0,
            height: (0.7, 1.05),
            width: (0.006, 0.01),
            tilt: (0.05, 0.25),
            bend: (0.0, 0.2),
            clumps: (size: 1.4, pull: 0.5, height: 0.3, facing: 0.3, splay: 0.5, patches: 0.6),
            colors: (
                root: (0.03, 0.05, 0.012),
                tip: (0.14, 0.18, 0.06),
                dry_tip: (0.26, 0.22, 0.09),
                dry: 0.3,
                variation: 0.15,
            ),
            gloss: 0.6,
            roughness: 0.42,
            translucency: 0.3,
            stiffness: 0.5,
            twin: false,
        ),
        // Sun-dried grass of the dry meadows: straw and olive, more of it lying over.
        (
            key: "dry-meadow",
            density: 40.0,
            height: (0.25, 0.55),
            width: (0.006, 0.012),
            tilt: (0.2, 0.7),
            bend: (0.15, 0.55),
            clumps: (size: 0.8, pull: 0.4, height: 0.5, facing: 0.5, splay: 0.35, patches: 0.85),
            colors: (
                root: (0.08, 0.07, 0.03),
                tip: (0.22, 0.2, 0.09),
                dry_tip: (0.3, 0.26, 0.13),
                dry: 0.45,
                variation: 0.15,
            ),
            gloss: 0.55,
            roughness: 0.45,
            translucency: 0.25,
            stiffness: 0.4,
            twin: true,
        ),
        // Marram on the coastal grey dune behind the beach: stiff, rolled, blue-green tussocks.
        // Beaches and open dune sand stay bare.
        (
            key: "marram",
            density: 40.0,
            height: (0.45, 0.9),
            width: (0.004, 0.007),
            tilt: (0.1, 0.45),
            bend: (0.05, 0.3),
            clumps: (size: 1.3, pull: 0.9, height: 0.45, facing: 0.1, splay: 0.9, patches: 1.0),
            colors: (
                root: (0.07, 0.08, 0.05),
                tip: (0.2, 0.22, 0.15),
                dry_tip: (0.3, 0.27, 0.18),
                dry: 0.4,
                variation: 0.12,
            ),
            gloss: 0.5,
            roughness: 0.45,
            translucency: 0.2,
            stiffness: 0.7,
            twin: true,
        ),
        // Wavy hair-grass of the pine and mixed forest floor: very fine, soft, yellow-green,
        // drooping over the moss.
        (
            key: "wavy-hair",
            density: 36.0,
            height: (0.18, 0.42),
            width: (0.003, 0.005),
            tilt: (0.3, 0.8),
            bend: (0.25, 0.65),
            clumps: (size: 0.6, pull: 0.7, height: 0.4, facing: 0.3, splay: 0.7, patches: 1.0),
            colors: (
                root: (0.025, 0.035, 0.01),
                tip: (0.13, 0.17, 0.04),
                dry_tip: (0.22, 0.2, 0.08),
                dry: 0.2,
                variation: 0.15,
            ),
            gloss: 0.5,
            roughness: 0.42,
            translucency: 0.4,
            stiffness: 0.25,
            twin: true,
        ),
    ],
    details: [
        // Pebbles of the beach, gravel and paths: 5-14 cm.
        (
            key: "pebbles",
            assets: ["local/details/pebbles.glb"],
            density: 1.5,
            scale: (1.0, 1.6),
            clumps: (size: 1.2, pull: 0.6, patches: 0.6),
            sink: 0.35,
            align: 0.8,
            tilt: 0.4,
            distance: 26.0,
            shadows: false,
        ),
        // Rounded cobbles at the waterline and on gravel: 5-25 cm.
        (
            key: "cobbles",
            assets: ["local/details/cobbles.glb"],
            density: 0.6,
            scale: (1.5, 3.0),
            clumps: (size: 2.0, pull: 0.7, patches: 0.8),
            sink: 0.3,
            align: 0.8,
            tilt: 0.3,
            distance: 34.0,
            shadows: false,
        ),
        // Angular stones of rocky ground, 10-30 cm.
        (
            key: "stones",
            assets: ["local/details/small_stones.glb"],
            density: 0.3,
            scale: (1.0, 2.0),
            clumps: (size: 2.5, pull: 0.6, patches: 0.7),
            sink: 0.35,
            align: 0.7,
            tilt: 0.4,
            distance: 45.0,
            shadows: true,
        ),
        // Rocks breaking through moss and meadow, 20-80 cm.
        (
            key: "rocks",
            assets: ["local/details/small_rocks.glb"],
            density: 0.05,
            scale: (1.5, 3.5),
            clumps: (size: 5.0, pull: 0.5, patches: 0.9),
            sink: 0.4,
            align: 0.6,
            tilt: 0.3,
            distance: 80.0,
            shadows: true,
        ),
        // Twigs on the forest floor, 5-40 cm.
        (
            key: "twigs",
            assets: ["local/details/twigs.glb"],
            density: 0.8,
            scale: (1.5, 3.0),
            clumps: (size: 1.5, pull: 0.4, patches: 0.5),
            sink: 0.15,
            align: 1.0,
            tilt: 0.15,
            distance: 26.0,
            shadows: false,
        ),
        // Bracken in patches over the forest floor and moss, 1-2.6 m across.
        (
            key: "ferns",
            assets: ["local/yarra_ferns/runtime/fern_upright/fern_upright_lod1.gltf", "local/yarra_ferns/runtime/fern_spreading/fern_spreading_lod1.gltf", "local/yarra_ferns/runtime/fern_sparse/fern_sparse_lod1.gltf"],
            density: 0.25,
            scale: (0.6, 1.0),
            clumps: (size: 7.0, pull: 0.3, patches: 1.0),
            sink: 0.05,
            align: 0.4,
            tilt: 0.1,
            distance: 60.0,
            shadows: true,
        ),
        // Nettles in clumps where the ground is rich: leaf litter, dirt, forest edges.
        (
            key: "nettles",
            assets: ["local/yarra_nettles/runtime/nettle_young/nettle_young_lod1.gltf", "local/yarra_nettles/runtime/nettle_mature/nettle_mature_lod1.gltf", "local/yarra_nettles/runtime/nettle_patch/nettle_patch_lod1.gltf"],
            density: 0.4,
            scale: (0.8, 1.2),
            clumps: (size: 4.0, pull: 0.5, patches: 1.0),
            sink: 0.02,
            align: 0.2,
            tilt: 0.1,
            distance: 45.0,
            shadows: true,
        ),
        // Lily of the valley carpeting the broadleaf floor.
        (
            key: "lilies",
            assets: ["local/yarra_lilies/runtime/lily_open/lily_open_lod1.gltf", "local/yarra_lilies/runtime/lily_full/lily_full_lod1.gltf", "local/yarra_lilies/runtime/lily_patch/lily_patch_lod1.gltf"],
            density: 0.6,
            scale: (0.6, 1.0),
            clumps: (size: 5.0, pull: 0.5, patches: 1.0),
            sink: 0.03,
            align: 0.6,
            tilt: 0.05,
            distance: 35.0,
            shadows: false,
        ),
        // Sorrel rosettes in the meadows.
        (
            key: "sorrel",
            assets: ["local/yarra_sorrel/runtime/sorrel_open/sorrel_open_lod1.gltf", "local/yarra_sorrel/runtime/sorrel_full/sorrel_full_lod1.gltf", "local/yarra_sorrel/runtime/sorrel_patch/sorrel_patch_lod1.gltf"],
            density: 0.3,
            scale: (0.7, 1.1),
            clumps: (size: 3.0, pull: 0.4, patches: 0.8),
            sink: 0.05,
            align: 0.5,
            tilt: 0.1,
            distance: 35.0,
            shadows: false,
        ),
    ],
    surfaces: {
        "meadow": [("meadow", 1.0), ("meadow-tall", 1.0), ("rocks", 0.02), ("stones", 0.03), ("sorrel", 0.08)],
        "dry-meadow": [("dry-meadow", 1.0), ("meadow-tall", 0.4), ("rocks", 0.05), ("stones", 0.1), ("pebbles", 0.05), ("sorrel", 0.04)],
        "coastal-grass": [("marram", 0.8), ("dry-meadow", 0.25), ("pebbles", 0.1), ("stones", 0.05)],
        "gravel": [("dry-meadow", 0.12), ("pebbles", 1.0), ("cobbles", 0.4), ("stones", 0.3)],
        "forest-moss": [("wavy-hair", 0.45), ("twigs", 0.5), ("rocks", 0.1), ("ferns", 0.8)],
        "forest-floor": [("wavy-hair", 0.3), ("twigs", 1.0), ("stones", 0.1), ("rocks", 0.08), ("ferns", 0.6), ("nettles", 0.08), ("lilies", 0.15)],
        "pine-needles": [("wavy-hair", 0.12), ("twigs", 0.8), ("rocks", 0.05), ("ferns", 0.25)],
        "leaf-litter": [("wavy-hair", 0.08), ("twigs", 1.0), ("ferns", 0.4), ("nettles", 0.15), ("lilies", 0.4)],
        "stony-moss": [("wavy-hair", 0.25), ("stones", 0.6), ("rocks", 0.6), ("twigs", 0.3), ("ferns", 0.3)],
        "beach-sand": [("pebbles", 0.3), ("cobbles", 0.25)],
        "dirt": [("pebbles", 0.5), ("stones", 0.2), ("nettles", 0.25)],
        "rocky-ground": [("pebbles", 1.0), ("stones", 0.8), ("rocks", 0.6)],
        "rock": [("stones", 0.3), ("rocks", 0.4)],
        "lichen-rock": [("stones", 0.3), ("rocks", 0.4)],
    },
)
