// Spoken while walking; nobody has to stop for it.
(
    id: "guard/banter",
    roles: {"player": Required, "speaker": Required},
    history_scope: Playthrough, repeat: OnceCompleted, mode: Ambient,
    start: ["remark"],
    nodes: [
        (id: "remark", kind: Line, speaker: "speaker", text: Message((resource: "guard/text", key: "banter-remark")), children: ["reply"]),
        (id: "reply", kind: Line, speaker: "player", text: Message((resource: "guard/text", key: "banter-reply"))),
    ],
)
