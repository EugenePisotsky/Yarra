    // The guard's own pouch.
    (id: "guard/pouch", entries: [
        (item: "healing_potion", quantity: (1, 3)),
        (item: "old_gate_key", quantity: (1, 1), chance: 10),
    ]),
    // The chest the guard unlocks.
    (id: "guard/supplies", entries: [
        (item: "healing_potion", quantity: (2, 2)),
    ]),
]
