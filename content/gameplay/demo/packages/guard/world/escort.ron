(
    id: "guard/escort",
    participant: "hero",
    speaker: "guard",
    activation: Maintained,
    condition: All([
        QuestStatus(quest: "guard/gate", status: Active),
        HasItem(definition: "old_gate_key", quantity: 1),
        InsideArea(area: "guard/approach"),
    ]),
    repeat: OnceSucceeded,
    steps: [
        Move(actor: Speaker, destination: (millimetres: (1800, 0, 0)), timeout_ms: 10000),
        Apply([
            Claim(claim: "guard/reward_claim", actions: [
                ConsumeItem(definition: "old_gate_key", quantity: 1),
                Quest(quest: "guard/gate", transition: CompleteObjective("deliver")),
                Quest(quest: "guard/gate", transition: Complete),
                AwardExperience(skill: "persuasion", amount: 10),
            ]),
            SetLocked(object: "guard/old_gate", locked: false),
            SetLocked(object: "guard/chest", locked: false),
        ]),
    ],
)
