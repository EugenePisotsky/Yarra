// With the quest running and the key in hand, stepping into the approach sends the guard
// to the gate. Any of the three can happen last, so all three are listened for.
(
    id: "guard/escort",
    player: "hero",
    speaker: Some("guard"),
    on: [
        Entered(actor: "hero", area: "guard/approach"),
        QuestStarted("guard/gate"),
        ItemAcquired(actor: "hero", definition: "old_gate_key"),
    ],
    condition: Some(All([
        QuestStatus(quest: "guard/gate", status: Active),
        HasItem(definition: "old_gate_key", quantity: 1),
        InsideArea(area: "guard/approach"),
    ])),
    actions: [Move(actor: Speaker, to: "guard/gate_post", timeout_ms: Some(10000))],
    // A walk that fails can be asked for again; the conditions stop holding once the key is returned.
    repeat: Always,
)
