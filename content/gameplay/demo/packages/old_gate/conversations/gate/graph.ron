(
    id: "old_gate/gate",
    roles: {"player": Required, "speaker": Required},
    history_scope: Interaction,
    repeat: OnceCompleted,
    start: ["greeting"],
    nodes: [
        (id: "greeting", kind: Line, speaker: "speaker", text: Message((resource: "old_gate/gate/text", key: "greeting")), children: ["return-key"]),
        (
            id: "return-key", kind: Choice, speaker: "player", text: Message((resource: "old_gate/gate/text", key: "return-key")),
            repeat: OnceEver,
            condition: Some(All([
                HasItem(definition: "old_gate_key", quantity: 1),
                Fact(key: "gate-rewarded", value: false),
            ])),
            actions: [
                ConsumeItem(definition: "old_gate_key", quantity: 1),
                SkillCheck(
                    skill: "persuasion",
                    difficulty: 1,
                    success: [
                        GrantItem(definition: "iron_sword", quantity: 1),
                        AwardExperience(skill: "persuasion", amount: 10),
                        SetFact(key: "gate-rewarded", value: true),
                    ],
                    failure: [],
                ),
            ],
        ),
    ],
)
