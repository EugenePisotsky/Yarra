// Roads of the Baltic island, imported with
//     cargo run --release -p yarra-world-cook -- import-roads content/roads/island.ron
// Styles are cart-track styles (environment::roads::CartTrackProfile) with the terrain surfaces
// their Ground preset lays down; routes are world XZ points through which a road curves. A road
// `from` a point of a road listed before it branches there, joined by a junction in that road's
// style. Routes were found as least-cost paths over the island's slopes. Importing again replaces
// these roads and styles by name; the editor edits them as any other road.
(
    styles: [
        // A two-track cart road: narrow wheel paths of packed soil and pale gravel chips sunk
        // into ruts, tall grass down the middle, trampled shoulders. Ragged edges with grass
        // biting in, tufts left in the tracks, grass breaking through in patches, tracks
        // wandering and changing width along the road (after tmp/references/roads).
        (
            name: "Baltic cart track",
            surfaces: [("dirt", 0.4), ("road-gravel", 0.3), ("packed-dirt", 0.3)],
            track_spacing: 1.45,
            track_width: 0.6,
            edge_softness: 0.08,
            center_ground: 0.15,
            center_retention: 0.95,
            shoulder_ground: 0.3,
            shoulder_retention: 0.75,
            track_retention: 0.1,
            edge_variation: 0.12,
            edge_patch_size: 1.4,
            track_wander: 0.1,
            track_wander_length: 6.0,
            breakup: 0.45,
            breakup_patch_size: 1.8,
            relief: (
                road_depth: 0.06,
                track_depth: 0.07,
                shoulder_falloff: 1.0,
                rut_roundness: 0.6,
                road_variation: 0.2,
                road_variation_length: 6.0,
                track_variation: 0.25,
                track_variation_length: 4.0,
            ),
        ),
        // A footpath: one worn track through the grass and litter, wandering, soft-edged.
        (
            name: "Forest footpath",
            surfaces: [("forest-dirt", 0.6), ("dirt", 0.25), ("leaf-litter", 0.15)],
            track_spacing: 0.0,
            track_width: 0.55,
            edge_softness: 0.08,
            center_ground: 0.0,
            center_retention: 1.0,
            shoulder_ground: 0.3,
            shoulder_retention: 0.6,
            track_retention: 0.0,
            edge_variation: 0.12,
            edge_patch_size: 1.2,
            track_wander: 0.12,
            track_wander_length: 5.0,
            breakup: 0.25,
            breakup_patch_size: 2.0,
            relief: (
                road_depth: 0.02,
                track_depth: 0.03,
                shoulder_falloff: 1.0,
                rut_roundness: 0.8,
                road_variation: 0.2,
                road_variation_length: 6.0,
                track_variation: 0.25,
                track_variation_length: 4.0,
            ),
        ),
    ],
    roads: [
        // From the start beach north through the pines to the northern meadows.
        (
            name: "Beach road",
            style: "Baltic cart track",
            width: 2.8,
            seed: 31,
            points: [(2881.6, 3117.8), (2882.4, 3025.9), (2883.3, 2934.0), (2820.2, 2864.0), (2816.0, 2768.0), (2806.0, 2730.0), (2756.2, 2618.0), (2716.2, 2562.0), (2716.0, 2454.0), (2730.0, 2424.0), (2729.3, 2324.0), (2728.7, 2224.0), (2629.1, 2120.0), (2606.9, 2062.0), (2533.1, 1958.0), (2505.6, 1906.0), (2443.9, 1853.1), (2382.2, 1800.2)],
        ),
        // West from the bend over the meadows (a fork 37 degrees off the beach road).
        (
            name: "West meadow track",
            style: "Baltic cart track",
            width: 2.8,
            seed: 47,
            from: ("Beach road", 12),
            points: [(2588.0, 2108.0), (2542.0, 2108.0), (2510.0, 2140.0), (2472.0, 2160.0), (2432.0, 2178.0), (2420.0, 2220.0), (2408.0, 2262.0), (2374.0, 2266.0)],
        ),
        // A footpath leaving the beach road south-west into the pines.
        (
            name: "Pine path",
            style: "Forest footpath",
            width: 1.4,
            seed: 53,
            from: ("Beach road", 8),
            points: [(2704.1, 2435.6), (2692.1, 2417.6), (2682.1, 2399.6), (2666.1, 2383.6), (2650.1, 2367.6), (2634.1, 2351.6), (2616.1, 2341.6), (2598.1, 2329.6), (2578.1, 2321.6), (2556.1, 2321.6), (2540.1, 2337.6), (2522.1, 2361.6)],
        ),
    ],
)
