+fn share_prepass_motion(
+    mut commands: Commands,
+    state: Res<State>,
+    views: Query<(Entity, &ViewPrepassTextures), With<TemporalFrame>>,
+) {
+    if !state.shared_motion {
+        return;
+    }
+    for (entity, prepass) in &views {
+        if let Some(motion) = &prepass.motion_vectors {
+            commands.entity(entity).insert(TemporalMotionTarget {
+                texture: motion.texture.texture.clone(),
+                view: motion.texture.default_view.clone(),
+            });
+        }
+    }
